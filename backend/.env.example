# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_here

# Supabase Credentials (Leave blank to use local SQLite + local file storage fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP Configuration (For email notifications. If blank, notifications are written to local console logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mzcet.edu.in
